PORT=4000

# Bill OCR engine: "openrouter" (vision LLM) or "tesseract" (local, no key).
# Defaults to openrouter when OPENROUTER_API_KEY is set, else tesseract.
OCR_PROVIDER=
# OpenRouter API key (get one at openrouter.ai). Needed for OCR_PROVIDER=openrouter.
# NOTE: the default model is a FREE endpoint that LOGS inputs for training —
# dev/demo only, do not send real user bills. Use a paid no-logging model for prod.
OPENROUTER_API_KEY=
# Optional: override the vision model (default nvidia/nemotron-nano-12b-v2-vl:free).
OCR_MODEL=

# --- Supabase ---------------------------------------------------------------
# All three come from your project's dashboard: Project Settings -> API.
#
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Anon / publishable key. Safe to expose; it is limited by Row-Level Security.
SUPABASE_ANON_KEY=
# Service role / secret key. BYPASSES Row-Level Security, so it grants full
# access to every row in the database.
#   - server-side only: never copy this into apps/web or any VITE_ variable
#   - if it ever leaks, rotate it immediately in the dashboard
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (next phase)
OPENAI_API_KEY=
