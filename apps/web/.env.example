# Web app environment variables.
#
# WARNING: Vite inlines every VITE_-prefixed value into the JavaScript bundle
# it ships to the browser. Anything here is public — treat it as if it were
# printed on the page. Never put a service role / secret key in this file.

# Where the Node API is served from. Defaults to the local dev server.
VITE_API_URL=http://localhost:4000

# --- Supabase (when auth moves off the local stand-in) -----------------------
# From the dashboard: Project Settings -> API. The anon key is designed to be
# public; Row-Level Security is what actually protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
